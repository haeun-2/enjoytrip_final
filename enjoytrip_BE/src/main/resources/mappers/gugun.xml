<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.trip.domain.attraction.region.GugunDao">

	<select id="selectByCode">
		select * from gugun where sido_code = #{sidoCode} and gugun_code = #{gugunCode}
	</select>
	
	<select id="select">
		select * from gugun where id = #{id}
	</select>

	<select id="selectAllBySido">
		select g.* from sido s join gugun g on s.sido_code = g.sido_code where s.id = #{sidoId}
	</select>

	<select id="selectAllBySidoCode">
		select * from gugun where sido_code = #{sidoCode}
	</select>

	<resultMap id="gugunMap" type="Gugun">
		<id column="id" property="id" />
		<result column="sido_code" property="sidoCode" />
		<result column="gugun_code" property="gugunCode" />
		<result column="gugun_name" property="gugunName" />
	</resultMap>
	
	
</mapper>